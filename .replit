modules = ["nodejs-20"]
run = "npm install && npm start"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
run = ["sh", "-c", "npm start"]
build = ["sh", "-c", "npm ci"]

[nix]
channel = "stable-25_05"

[workflows]

[[workflows.workflow]]
name = "start app"
mode = "sequential"
author = 67180105

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install && npm start"
